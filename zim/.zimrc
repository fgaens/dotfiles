# Zim module list; startup reads it only when regenerating init.zsh.
# After edits, run `zimfw install` and start a new shell (`exec zsh -l` on macOS).

# Homebrew — MUST BE FIRST
zmodule homebrew
zmodule environment
zmodule input
zmodule termtitle
zmodule utility

# Prompt (gitster needs prompt-pwd + git-info)
zmodule prompt-pwd
zmodule git-info
zmodule gitster

# Completion — after modules that add fpath
zmodule zsh-users/zsh-completions --fpath src
zmodule fzf
zmodule completion

# Must be last
zmodule zsh-users/zsh-syntax-highlighting
zmodule zsh-users/zsh-history-substring-search
zmodule zsh-users/zsh-autosuggestions
